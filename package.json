{
  "name": "valeros-nde",
  "version": "0.11.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "codegen": "graphql-codegen --config codegen.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\" \"e2e/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\" \"e2e/**/*.ts\" \"*.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit"
  },
  "private": true,
  "overrides": {
    "react-i18next": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@angular/cdk": "^21.2.11",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@ng-icons/core": "^33.2.2",
    "@ng-icons/feather-icons": "^33.2.2",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "leaflet": "^1.9.4",
    "mirador": "^4.0.0",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.0",
    "tify": "^0.35.0",
    "tslib": "^2.3.0",
    "universalviewer": "^4.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@axe-core/playwright": "^4.12.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.21",
    "autoprefixer": "^10.4.27",
    "daisyui": "^4.12.24",
    "mermaid": "^11.15.0",
    "postcss": "^8.5.9",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitepress": "^1.5.0",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.13"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "canvas@2.11.2": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "tify@0.35.0": true
  }
}
